# --- gateway ---
PORT=8787
# 监听地址：0.0.0.0 = 局域网内设备都能访问；127.0.0.1 = 只有本机
HOST=127.0.0.1
# 启用局域网访问时请设独立密钥，调用方发送 Authorization: Bearer <key>
GATEWAY_KEY=

# 默认通道；模型 ID 带 provider:: 前缀时按该前缀选择已启用通道
ADAPTER=solo
# 启动补签并每15分钟自动复查；设0可关闭
AUTO_CHECKIN_ENABLED=1
# Qoder 默认读取当前 Windows 用户的桌面授权；设 0 可关闭
# AUTO_DISCOVER_DESKTOP_AUTH=0

# --- trae upstream ---
# 网关会从 Trae CN 安装补充应用信息。可通过 TRAE_TOKEN 提供 Cloud-IDE-JWT。
# TRAE_HEADERS、TRAE_DEVICE_ID 或 config/trae-session.json 可用于手工配置。
TRAE_CAPTURE=0
TRAE_TIMEOUT_MS=180000
# solo 通道排队可能几分钟
SOLO_TIMEOUT_MS=600000

# --- Doubao desktop ---
# 设为 0 关闭豆包通道；默认读取当前 Windows 用户刷新的加密授权
# DOUBAO_ENABLED=0
# 非默认客户端用户目录或加密授权文件可在当前电脑覆盖
# DOUBAO_USER_DATA=C:\path\to\Doubao\User Data
# DOUBAO_AUTH_FILE=C:\path\to\doubao-auth.dpapi
# 单次调用超时（毫秒）
# DOUBAO_TIMEOUT_MS=180000
